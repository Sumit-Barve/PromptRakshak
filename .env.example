# ==============================================================================
# Aegis AI — Agent Security Command Center Configuration
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS:
#   copy .env.example .env (Windows PowerShell: Copy-Item .env.example .env)
#
# IMPORTANT SECURITY NOTES:
# - Never commit the .env file with real secrets.
# - The backend automatically redacts secrets and never exposes them to the UI or logs.
# - If LLM_API_KEY is left empty, the application runs seamlessly in DEMO FALLBACK MODE.
# ==============================================================================

# LLM Provider: "openai", "gemini", "anthropic", "groq", "ollama", or "custom"
# Default fallback if empty: "demo" (Demo Fallback Mode)
LLM_PROVIDER=demo

# Your LLM API key. Redacted automatically by Aegis AI backend.
# (Leave blank to use Demo Fallback Mode without any API keys)
LLM_API_KEY=

# Model Name
# Examples:
#   OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
#   Gemini: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
#   Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
#   Groq: llama-3.3-70b-versatile
LLM_MODEL=gpt-4o-mini

# Base URL (Optional / Provider-specific)
# - For OpenAI: leave empty or https://api.openai.com/v1
# - For Gemini (OpenAI compat): https://generativelanguage.googleapis.com/v1beta/openai/
# - For Groq: https://api.groq.com/openai/v1
# - For Ollama: http://localhost:11434/v1
# - For OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=

# Timeout in seconds for LLM API calls (Default: 30)
LLM_TIMEOUT_SECONDS=30

# Maximum agent tool-calling iterations (Default: 5)
AGENT_MAX_ITERATIONS=5

# Server Port and Host
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./aegis.db
